rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'simon.borali7@gmail.com';
    }

    function nominatorPath(token) {
      return /databases/$(database)/documents/dancers/$(token);
    }

    // A nomination is only valid if it names a real, approved dancer as the nominator,
    // and the claimed nominator name matches that dancer's actual name (prevents
    // impersonation now that the nominate form no longer asks for a typed-in name).
    function isApprovedNominator(token, claimedName) {
      return token is string
        && exists(nominatorPath(token))
        && get(nominatorPath(token)).data.status == 'approved'
        && get(nominatorPath(token)).data.name == claimedName;
    }

    match /dancers/{token} {
      // Anyone holding a token can look up that one dancer (invite.html, nominate.html).
      allow get: if true;
      // Nobody but the admin can list/enumerate all dancers — keeps tokens unguessable.
      allow list: if isAdmin();

      allow create: if isAdmin() || isNewNomineeCreate();
      allow update: if isAdmin() || isReceivedIncrement() || isSentIncrement() || isSelfNameUpdate();
      allow delete: if isAdmin();

      // First time this person has ever been nominated: creates their record as 'pending'.
      function isNewNomineeCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly(
                 ['name', 'contact', 'nameKey', 'status', 'receivedNominationCount',
                  'receivedNominators', 'sentNominationCount', 'sentNominatedNames', 'createdAt']
               )
          && d.status == 'pending'
          && d.receivedNominationCount == 1
          && d.receivedNominators.size() == 1
          && d.sentNominationCount == 0
          && d.sentNominatedNames.size() == 0
          && isApprovedNominator(d.receivedNominators[0].nominatorToken, d.receivedNominators[0].name);
      }

      // This person was already nominated before (matched by name): bump their received count by exactly one.
      // Uses get() with a default so records from before these fields existed self-heal
      // instead of getting permanently stuck (treats a missing field as 0 / empty list).
      function isReceivedIncrement() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['receivedNominationCount', 'receivedNominators'])
          && after.receivedNominationCount == before.get('receivedNominationCount', 0) + 1
          && after.receivedNominators.size() == before.get('receivedNominators', []).size() + 1
          && isApprovedNominator(
               after.receivedNominators[after.receivedNominators.size() - 1].nominatorToken,
               after.receivedNominators[after.receivedNominators.size() - 1].name
             );
      }

      // A dancer tracking their own "sent" nominations, capped at 10, one at a time.
      // Same self-healing default as above for records missing these fields.
      function isSentIncrement() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['sentNominationCount', 'sentNominatedNames'])
          && after.sentNominationCount == before.get('sentNominationCount', 0) + 1
          && after.sentNominationCount <= 10
          && after.sentNominatedNames.size() == before.get('sentNominatedNames', []).size() + 1;
      }

      // A dancer editing their own display name from their invite page (e.g. filling in
      // a proper first/last name in place of a nickname). Only these two fields may move.
      function isSelfNameUpdate() {
        let after = request.resource.data;
        return after.diff(resource.data).affectedKeys().hasOnly(['name', 'nameKey'])
          && after.name is string && after.name.size() > 0 && after.name.size() <= 200
          && after.nameKey is string && after.nameKey.size() > 0;
      }
    }

    // Public aggregate counts shown on invite.html (nominee count, total nominations).
    // Only the admin dashboard recomputes and writes this doc — public clients can't query
    // the dancers collection directly (see the "list" rule above), so this is the only way
    // to surface those numbers without breaking the unguessable-token privacy model.
    match /stats/global {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Team calendar (per-Friday attendance for the team). Purely an internal admin
    // planning tool — never exposed to dancers, so it's admin-only end to end.
    match /calendarAttendance/{date} {
      allow read, write: if isAdmin();
    }

    // Maps a normalized name to the dancer token for that person, so a nominator can check
    // "has this person already been nominated?" with a plain get() — without needing
    // list/query access to the dancers collection (which would let anyone enumerate every
    // dancer and break the unguessable-token privacy model).
    match /nameIndex/{nameKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
                    || (request.resource.data.keys().hasOnly(['token']) && request.resource.data.token is string);
      allow update, delete: if isAdmin();
    }

    // Audit trail of self-service name edits, so the admin can spot misuse (e.g. someone
    // overwriting their name with a different real person's name). Write-only for the
    // public — only the admin can read it back.
    match /nameChangeLog/{id} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    || (request.resource.data.keys().hasOnly(['token', 'oldName', 'newName', 'timestamp'])
                        && request.resource.data.token is string
                        && request.resource.data.oldName is string
                        && request.resource.data.newName is string
                        && request.resource.data.timestamp == request.time);
      allow update, delete: if isAdmin();
    }
  }
}
